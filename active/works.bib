@article{Chwistek1922c,
  author = {Leon Chwistek},
  title  = {Über die Antinomien der Prinzipien der Mathematik},
  year   = {1922},
  pages  = {236--243},
  note   = {Published in Mathematische Zeitschrift, vol. 14. Quote: "Sprechen wir der Richardschen Antinomie jeden theoretischen Wert ab, so bekommt die formale Logik eine wesentliche Vereinfachung, da wir nun wohl mit Typen, aber nicht mehr mit Rängen von Funktionen zu tun haben, womit es uns ermöglicht wird, kurzweg von 'allen Eigenschaften' eines Dinges zu sprechen. Auf diese Weise können wir ohne weiteres aus dem Whitehead-Russellschen System ein neues System gewinnen, welches denselben theoretischen Wert wie jenes haben muss. Es bleibt aber immer mancher Zweifel über die Widerspruchslosigkeit dieses Systems übrig, und unbeschadet dieses Bedenkens—bleibt immer folgende Frage von prinzipieller Wichtigkeit übrig: Ist ein System der formalen Logik möglich, welches auf der allgemeinen Typentheorie—ohne Reduzibilitätsatz gegründet wäre und sonst keine neuen Axiome vorauszusetzen hatte? Auf diese Frage bin ich imstande eine bejahende Antwort zu geben."}
